{
  "name": "limjaejoon.com",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "storybook": "STORYBOOK_DISABLE_TELEMETRY=1 storybook dev -p 6006",
    "build-storybook": "STORYBOOK_DISABLE_TELEMETRY=1 storybook build",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "fsd": "CHOKIDAR_USEPOLLING=1 steiger ./src",
    "ci": "npm run fsd && npm run lint && npm run type-check && npm run test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:types": "supabase gen types typescript --local > src/shared/api/supabase/database.types.ts",
    "blog:import": "node scripts/blog-import/importPosts.mjs",
    "auth:set-admin": "node --env-file=.env.local scripts/set-admin-role.mjs"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.0",
    "@gsap/react": "^2.1.2",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.1",
    "@uiw/react-codemirror": "^4.25.11",
    "@vanilla-extract/css": "^1.20.1",
    "@vanilla-extract/next-plugin": "^2.5.1",
    "@vanilla-extract/sprinkles": "^1.6.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "gsap": "^3.15.0",
    "next": "16.2.9",
    "next-mdx-remote": "^6.0.0",
    "radix-ui": "^1.5.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "^0.14.3",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.0.2"
  },
  "devDependencies": {
    "@feature-sliced/steiger-plugin": "^0.6.0",
    "@storybook/addon-a11y": "^10.4.4",
    "@storybook/addon-docs": "^10.4.4",
    "@storybook/nextjs-vite": "^10.4.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vanilla-extract/recipes": "^0.5.7",
    "@vanilla-extract/vite-plugin": "^5.2.2",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "jsdom": "^29.1.1",
    "msw": "^2.14.6",
    "prettier": "^3.8.1",
    "steiger": "^0.5.13",
    "storybook": "^10.4.4",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}
