# Supabase target
# local: 로컬 Supabase, remote: 원격 운영 Supabase
NEXT_PUBLIC_SUPABASE_TARGET=local

# Admin editor
# 서버 Route Handler 에서만 검증한다. 브라우저에 노출되는 NEXT_PUBLIC_ prefix 를 붙이지 않는다.
ADMIN_POST_TOKEN=

# Local Supabase reference
NEXT_PUBLIC_LOCAL_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_LOCAL_SUPABASE_ANON_KEY=
LOCAL_SUPABASE_SERVICE_ROLE_KEY=
LOCAL_POST_IMAGE_BUCKET=post-images-local

# Remote production Supabase reference
NEXT_PUBLIC_REMOTE_SUPABASE_URL=
NEXT_PUBLIC_REMOTE_SUPABASE_ANON_KEY=
REMOTE_SUPABASE_SERVICE_ROLE_KEY=
REMOTE_POST_IMAGE_BUCKET=post-images
